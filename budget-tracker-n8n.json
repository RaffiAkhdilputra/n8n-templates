    {
      "parameters": {
        "jsCode": "let raw = $input.first().json.content.parts[0].text;\n\n// Remove all backticks anywhere\nraw = raw.replace(/`+/g, \"\");\n\n// Remove \"json\" if it appears after backticks\nraw = raw.replace(/json\\n?/gi, \"\");\n\n// Trim extra whitespace\nraw = raw.trim();\n\n// Parse safely\nlet data = JSON.parse(raw);\n\n// Convert month number -> month name\nfunction getMonthName(dateString) {\n  const parts = dateString.split(\"/\");\n  const monthNum = parseInt(parts[1], 10);\n\n  const monthNames = [\n    \"January\", \"February\", \"March\", \"April\", \"May\", \"June\",\n    \"July\", \"August\", \"September\", \"October\", \"November\", \"December\"\n  ];\n\n  return monthNames[monthNum - 1];\n}\n\nfunction getYear(dateString) {\n  const parts = dateString.split(\"/\");\n  const year = parseInt(parts[2])\n\n  return year\n}\n\nconst monthName = getMonthName(data.date);\nconst year = getYear(data.date)\n\nlet items = data.items || {};\n\nconst output = Object.entries(items).map(([name, price]) => ({\n  json: {\n    month: monthName,\n    year: year,\n    date: data.date,\n    transaction_recipient: data.transaction_recipient,\n    transaction_platform: data.transaction_platform,\n    name,\n    price,\n    total: data.total,\n  }\n}));\n\nreturn output;\n"
      },
