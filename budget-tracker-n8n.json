    {
      "parameters": {
        "language": "python",
        "pythonCode": "import json\n\n_MONTHLY_INCOME = 5000000\n\ndata = _input.first().json\n\n# Read previous totals safely\nTOTAL_EXPENSES = data.get(\"TOTAL_EXPENSES\", 0)\nMONEY_SAVED = data.get(\"MONEY_SAVED\", 0)\n\nSELECTED_MONTH = data.get(\"month\", \"\")\nSELECTED_YEAR = data.get(\"year\", \"\")\n\n# New total from receipt\nnew_total = data.get(\"total\", 0)\n\n# Convert to list if needed\nif not isinstance(TOTAL_EXPENSES, list):\n    TOTAL_EXPENSES = [TOTAL_EXPENSES]\n\nif not isinstance(MONEY_SAVED, list):\n    MONEY_SAVED = [MONEY_SAVED]\n\n# Last previous values\nlast_total = TOTAL_EXPENSES[-1] if TOTAL_EXPENSES else 0\nlast_saved = MONEY_SAVED[-1] if MONEY_SAVED else _MONTHLY_INCOME\n\n# Updated values\nupdated_total = last_total + new_total\n\nif last_saved == 0:\n    updated_saved = _MONTHLY_INCOME - new_total\nelse:\n    updated_saved = last_saved - new_total\n\n# Output\nreturn {\n    \"MONTH\": SELECTED_MONTH,\n    \"YEAR\": SELECTED_YEAR,\n    \"TOTAL_EXPENSES\": updated_total,\n    \"MONEY_SAVED\": updated_saved\n}\n"
      },
